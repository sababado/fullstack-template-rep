# Automated review of every PR push by Claude. Needs the repository secret
# CLAUDE_CODE_OAUTH_TOKEN (run `claude setup-token`, or use an API key input).
name: Claude review

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
  pull-requests: write
  id-token: write

concurrency:
  group: claude-review-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  review:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 1
      - uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          track_progress: true
          allowed_bots: 'dependabot[bot]'
          prompt: |
            Review this pull request. Read CLAUDE.md and the Agents.md for each area the
            diff touches before judging it.

            Check correctness first, then: security (input validation, auth checks on
            every route, no secrets), error handling (AppError subclasses, the error
            envelope), migrations (reversible, matching the models), accessibility and
            UI-kit usage (semantic tokens, no raw colors, every string translated),
            tests for new behavior, and docs for changed behavior.

            Post inline comments on specific lines. Finish with one summary comment
            that lists findings by severity: blocking, should fix, optional. Say
            plainly when you find nothing to fix.
          claude_args: >-
            --allowedTools "mcp__github_inline_comment__create_inline_comment,Bash(gh pr comment:*),Bash(gh pr diff:*),Bash(gh pr view:*),Read,Grep,Glob"
