# Deployed builds get these from the deploy workflow (backend stack outputs).
# Copy to .env.local to point your local frontend at a deployed backend.
VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
VITE_OIDC_CLIENT_ID=exampleclientid
VITE_COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
